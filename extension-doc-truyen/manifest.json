{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.3.2",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://comic.io.vn",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "src/icons/icon-16.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "commands": {
    "dich-trang-nay": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Translate current visible comic page / Dịch trang đang xem"
    },
    "dich-ca-chapter": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Auto-translate entire chapter / Tự động dịch cả chapter"
    },
    "tu-dich-khi-cuon": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "Toggle auto-translate on scroll / Bật tắt tự dịch khi cuộn"
    },
    "khoanh-vung-dich": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Snip & translate area (Canvas/DRM) / Khoanh vùng dịch"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/index.html",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/phim-tat.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib/chon-anh.js",
        "src/lib/toa-do.js",
        "src/fonts/Bangers-Regular.ttf",
        "src/fonts/ShantellSans-Regular.ttf",
        "src/fonts/Mansalva-Regular.ttf",
        "src/fonts/SigmarOne-Regular.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
