# ---- Database (Postgres / Supabase) ----
# Local docker-compose (default):
DATABASE_URL=postgresql+asyncpg://translation:translation@db:5432/translation
# Supabase managed (thay thế dòng trên khi dùng Supabase):
# DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Alembic dùng driver sync riêng (tự suy ra từ DATABASE_URL nếu để trống)
# ALEMBIC_DATABASE_URL=postgresql+psycopg://translation:translation@db:5432/translation

# ---- Redis / Celery (job queue cho M2-M9) ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Storage ảnh gốc / ảnh clean ----
# local = lưu trên volume (mặc định, đã verify ở M1)
# supabase = Supabase Storage (adapter CHƯA implement ở M1 - xem docs/ARCH.md)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=manga-pages

# ---- Upload limits ----
MAX_UPLOAD_MB=25

# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- M2: comic-text-detector ----
# Tải weight (KHÔNG commit vào git) — xem docs/ARCH.md muc Model weight:
#   curl -L -o models/comic-text-detector.onnx \
#     https://huggingface.co/mayocream/comic-text-detector-onnx/resolve/main/comic-text-detector.onnx
MODEL_WEIGHTS_PATH=/models/comic-text-detector.onnx
CTD_DEVICE=cpu
CTD_CONF_THRESHOLD=0.5
CTD_RAW_MIN_CONF=0.25
CTD_NMS_IOU=0.45
CTD_INPUT_SIZE=1024
CTD_INTRA_OP_THREADS=0
CTD_OVERLAP_SUSPECT_RATIO=0.8
# Do that tren workspace nay (CPU): ~39s/anh 1400x2000 -> de 120s cho an toan.
DETECT_TIMEOUT_SECONDS=120

# ---- M3: OCR ----
OCR_DEVICE=cpu
# Chỉ áp cho engine CÓ confidence thật (PaddleOCR); manga-ocr không trả confidence -> NULL
OCR_CONF_THRESHOLD=0.5
# Timeout RIÊNG của OCR (N vùng/trang) — đo thật rồi chỉnh, xem docs/TEST_LOG.md
OCR_TIMEOUT_SECONDS=900
# Detect xong tự chạy OCR (pipeline tự chảy)
OCR_AUTO_CHAIN=true

# ---- M4: inpaint (LaMa) ----
# Tải weight (KHÔNG commit vào git) — xem docs/ARCH.md muc Model weight:
#   curl -L -o models/lama-manga-dynamic.onnx \
#     https://huggingface.co/ogkalu/lama-manga-onnx-dynamic/resolve/main/lama-manga-dynamic.onnx
INPAINT_WEIGHTS_PATH=/models/lama-manga-dynamic.onnx
INPAINT_DEVICE=cpu
INPAINT_DILATE_RATIO=0.08
# Do that: 54,3s/anh 1400x2000 tren CPU, chua tinh buoc kiem chung OCR lai
INPAINT_TIMEOUT_SECONDS=900
INPAINT_AUTO_CHAIN=true
INPAINT_VERIFY_BY_OCR=true
INPAINT_INTRA_OP_THREADS=0
INPAINT_ALLOW_OPENCV_FALLBACK=false

# ---- M5: dịch ----
# MẶC ĐỊNH google_fast (miễn phí) — hệ thống KHÔNG bao giờ tự tiêu token khi user chưa chọn.
# Đổi sang llm_context là quyết định có ý thức (có test canh mặc định này).
TRANSLATE_DEFAULT_ENGINE=google_fast
# Nhiều key ngăn cách bằng dấu phẩy. CHỈ nằm ở .env, không bao giờ vào DB/git.
# LƯU Ý: Gemini tính rate limit theo PROJECT chứ không theo key -> nhiều key CÙNG project
# không tăng hạn mức; muốn tăng thật thì key phải thuộc project khác nhau.
GEMINI_API_KEYS=
# gemini-2.5-flash đã bị Google chặn với key mới (404 "no longer available to new users").
LLM_MODEL_NAME=gemini-3.1-flash-lite
# 0 = TẮT thinking. Đo thật: không tắt -> 938 token suy nghĩ cho 6 dòng (đắt gấp ~7,7 lần).
LLM_THINKING_BUDGET=0
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=8192
# LLM lỗi/hết quota -> lùi về google_fast và đánh dấu status=fallback_used (không trả bản rỗng).
LLM_FALLBACK_TO_GOOGLE=true
# Timeout RIÊNG của dịch, không dùng chung với detect/OCR/inpaint.
TRANSLATE_TIMEOUT_SECONDS=900
TRANSLATE_AUTO_CHAIN=true
# Ép hướng đọc (ltr|rtl). Rỗng HOẶC `auto` = suy theo source_lang (ja -> rtl, en/zh -> ltr).
#
# Dùng `auto` khi nền tảng hosting KHÔNG nhận biến môi trường rỗng (VibeHost bắt tối thiểu 1 ký
# tự). Đừng điền bừa `ltr`/`rtl` cho qua cổng: cả hai ép cứng TOÀN hệ thống và làm hỏng thứ tự
# đọc của đúng một nửa số chapter, mà không một thông báo lỗi nào.
READING_DIRECTION_OVERRIDE=auto

# ---- M6: canh chữ vào bubble ----
FONT_DIR=/fonts
DEFAULT_FONT_FAMILY=Bangers
# Font hỏng/thiếu glyph => lỗi RÕ. Bật true nghĩa là chấp nhận bị đổi font âm thầm.
ALLOW_FONT_FALLBACK=false
TYPESET_MIN_FONT_SIZE=10
# Đo thật trên trang 1400x2000: để 28 (spec đề xuất) thì 5/6 vùng dừng đúng ở trần
# => chữ nhỏ hơn mức đáng ra vừa được. 40 là điểm hết chạm trần.
TYPESET_MAX_FONT_SIZE=40
TYPESET_PADDING_RATIO=0.09
TYPESET_LINE_SPACING_RATIO=0.18
TYPESET_STROKE_WIDTH=0
TYPESET_TIMEOUT_SECONDS=600
TYPESET_AUTO_CHAIN=true

# ---- M9: chạy cả chapter theo mẻ ----
BATCH_ENABLED=true
# Số trang chạy song song trong một mẻ. Để 1 vì worker đang chạy --concurrency=1 và bước xoá chữ
# đã đo được ~1,1GB RAM/trang; nâng lên phải đo lại RAM trước, không đoán.
BATCH_MAX_CONCURRENT_PAGES=1
# Chỉ áp cho lỗi TẠM THỜI (429 quá nhịp, 408, 5xx, mạng). Lỗi vĩnh viễn hỏng ngay, zero retry.
BATCH_MAX_RETRIES=3
BATCH_RETRY_BACKOFF_BASE_SECONDS=2
BATCH_RETRY_BACKOFF_MAX_SECONDS=120
BATCH_RETRY_JITTER=true
# Mục kẹt `running` lâu hơn ngần này coi như worker đã chết và được xếp lại.
# PHẢI lớn hơn bước chậm nhất (xoá chữ đo được ~72s/trang, timeout 1800s).
BATCH_STALE_ITEM_SECONDS=2400
# Hạn mức gọi Gemini theo PROJECT (lượt/phút) — cửa sổ trượt nguyên tử trong Redis, dùng chung cho
# MỌI worker. Không dùng Task.rate_limit của Celery vì nó chỉ giới hạn từng worker instance.
# <=0 = tắt cổng. Số dưới đây là số dev: phải đo hạn mức thật rồi mới chốt cho chạy thật.
LLM_PROJECT_RPM=10
LLM_QUOTA_MODE=redis_sliding_window

# ---- Chạy thật (deploy) ----
# Tên miền được phép gọi API, ngăn cách bằng dấu phẩy. RỖNG = chặn mọi lời gọi chéo nguồn.
# Cố ý KHÔNG mặc định `*`. Ví dụ: https://translation-web.cmc-1.vibenode.matbao.ai
#
# LƯU Ý: biến này thuộc tầng **API FastAPI lúc chạy thật**. Máy chủ dev của Vite có biến RIÊNG
# là `DEV_SERVER_CORS_ALLOW_ORIGINS` (đặt ở shell, không đặt ở tệp này để khỏi bơm khoá API vào
# container giao diện). Hai tầng cố ý KHÔNG dùng chung danh sách — xem `docs/SECURITY.md` §2.
CORS_ALLOW_ORIGINS=

# ---- E49: Hạn mức sử dụng (trang/ngày) ----
# Đơn vị là TRANG, không phải chapter/tệp/lần bấm — chi phí thật tính theo trang.
HAN_MUC_KHACH_LA=6
HAN_MUC_CO_TAI_KHOAN=10
# Trần theo IP cho khách lạ. PHẢI lớn hơn HAN_MUC_KHACH_LA: văn phòng, trường học, quán cà phê
# dùng chung một IP — đặt bằng nhau là chặn oan hàng loạt người dùng thật.
HAN_MUC_IP_KHACH_LA=25
# BẮT BUỘC tường minh. Container chạy UTC, người dùng và chính sách theo UTC+7.
MUI_GIO_HAN_MUC=Asia/Ho_Chi_Minh

# Muối băm định danh khách lạ (cookie + IP). BẮT BUỘC đặt ở production, giá trị ngẫu nhiên dài.
# Để rỗng thì hạn mức vẫn đúng, nhưng SHA-256 không muối của một địa chỉ IPv4 là dò được toàn bộ
# (4 tỉ địa chỉ băm hết chỉ mất vài phút) ⇒ ai đọc được CSDL sẽ khôi phục lại IP thô.
MUOI_BAM_KHACH=
# ⚠️ BẪY TRIỂN KHAI — đọc trước khi deploy.
#
# Nền tảng Vibe Host đọc CHÍNH TỆP NÀY ở gốc repo và CHẶN redeploy với `ENV_REQUIRED` cho mọi
# biến khai ở đây mà **để rỗng** và chưa được cấp trên project.
#
# Repo này có HAI project trên cùng một nguồn (`translation-api` và `translation-web`), nên khai
# một biến rỗng ở đây là chặn luôn cả lượt deploy GIAO DIỆN — dù giao diện không đọc biến đó.
# Đã xảy ra thật 26-09-2026: thêm dòng `MUOI_BAM_KHACH=` làm `translation-web` không deploy được.
#
# Cố ý KHÔNG điền giá trị mẫu vào đây: nền tảng có thể copy giá trị sang project mới, và một muối
# băm ai cũng biết thì còn tệ hơn không có muối — mà `/healthz` lại báo `muoi_bam_khach_da_dat:
# true`, tức phép chẩn đoán sẽ nói dối.
#
# ⇒ Cách xử lý: cấp biến này cho CẢ HAI project. Ở `translation-web` cứ để một giá trị vô nghĩa
#   (nó không đọc), ở `translation-api` phải là giá trị ngẫu nhiên dài và đánh dấu bí mật.

# Có tin `X-Forwarded-For` không. MẶC ĐỊNH KHÔNG, và đó là mặc định đúng.
# Header này do client gửi và sửa được tuỳ ý. Chỉ bật khi CHẮC CHẮN mọi request đều đi qua proxy
# nhà mình VÀ proxy đó GHI ĐÈ header — nếu không, ai cũng tự đổi được "IP" của mình và chốt IP
# biến mất mà không ai thấy.
TIN_HEADER_PROXY=false
# Cookie khách chỉ gửi qua HTTPS. Đặt false CHỈ cho máy phát triển chạy HTTP thuần.
COOKIE_KHACH_SECURE=true

# ---- E50: Vòng đời tệp (chapter tự xoá) ----
# Giữ kết quả bao lâu, tính từ lúc CẢ CHAPTER xong (không phải lúc tải lên).
GIU_KET_QUA_PHUT=30
# Có áp luật tự xoá cho chapter của TÀI KHOẢN ĐÃ ĐĂNG KÝ không.
# true = đúng đặc tả §2.1. false = chỉ dọn chapter của khách lạ.
# ⚠️ Đây là công tắc của hành vi XOÁ DỮ LIỆU KHÔNG HOÀN TÁC ĐƯỢC. Chốt trước khi bật lịch dọn.
TU_XOA_CHO_TAI_KHOAN=true
# Bao lâu chạy một lượt dọn (giây). Lượt dọn chạy CHUNG tiến trình worker đang bó bộ nhớ.
DON_TEP_MOI_GIAY=300
# ⛔ MẶC ĐỊNH TẮT, và ĐỪNG BẬT trước khi có phần TỰ ĐỘNG TẢI VỀ.
# Đặc tả §3 nói thẳng: làm luật 30 phút mà không có tự tải về là bày ra một cái bẫy — người dùng
# đóng tab rồi quên là mất hẳn. Bật lịch trước khi có phần đó là cố ý dựng cái bẫy.
BAT_LICH_DON_TEP=false
