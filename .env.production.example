# ==============================================================================
# CẤU HÌNH THƯƠNG MẠI HOÁ & VẬN HÀNH TỐC ĐỘ CAO (E95 - E100)
# Sao chép các biến cần thiết vào tệp `.env` trên máy chủ Production của bạn.
# ==============================================================================

# 1. TỐC ĐỘ DỊCH SIÊU TỐC (~4s/trang) & GIỮ NGỮ CẢNH LIÊN TRANG (E95, E96, E97)
# Bật `ai_gemini` để kích hoạt đường gộp 1-chạm (Single-Pass Detect + OCR + Dịch ngữ cảnh)
DETECT_ENGINE=ai_gemini
DETECT_AI_SO_LUOT=1
TRANSLATE_DEFAULT_ENGINE=google_fast
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. BỘ NHỚ ĐỆM ẢNH DỊCH SHA-256 (TIẾT KIỆM 90% CHI PHÍ KHI NHIỀU NGƯỜI CÙNG ĐỌC 1 TRUYỆN)
DOC_TRUYEN_DUNG_CACHE_ANH=true

# 3. HẠN MỨC FREEMIUM & CHỐNG LẠM DỤNG (E49, E100)
HAN_MUC_KHACH_LA=2
HAN_MUC_IP_KHACH_LA=25
HAN_MUC_CO_TAI_KHOAN=10
SO_TAI_KHOAN_MOI_MOI_IP_MOT_NGAY=2
SO_LAN_DANG_NHAP_SAI_MOI_IP_MOT_NGAY=10
SO_LAN_CHAY_LAI_TOI_DA_MOI_TRANG=5
MUOI_BAM_KHACH=thay_bang_chuoi_bi_mat_ngau_nhien_32_ky_tu

# 4. CỔNG THANH TOÁN TRỰC TUYẾN AN TOÀN (VIETQR/SEPAY HMAC · STRIPE · PAYPAL V2 · CẢNH BÁO TELEGRAM)
# Cổng nào để trống biến bí mật sẽ TỰ ĐỘNG TẮT (tuyệt đối không dùng secret mẫu công khai).
NGAN_HANG_TEN=MB
NGAN_HANG_SO_TK=
NGAN_HANG_CHU_TK=
TY_LE_VND_MOI_TRANG=500
# Webhook chuẩn HMAC-SHA256 (`X-SePay-Signature`) gọi vào POST /api/v1/thanh-toan/webhook/sepay
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_SECRET_PREVIOUS=

# Quốc tế — Thẻ Visa/Mastercard/Apple Pay/Google Pay (POST /api/v1/thanh-toan/webhook/stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=

# Quốc tế — PayPal Orders API v2 (POST /api/v1/thanh-toan/webhook/paypal)
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_EMAIL=
PAYPAL_WEBHOOK_ID=

# Cảnh báo đối soát tức thì khi phát sinh sai lệch chuyển khoản (`payment_reviews`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAYMENT_ALERT_WEBHOOK_URL=
